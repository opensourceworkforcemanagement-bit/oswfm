{
  "info": {
    "_postman_id": "code-types-collection",
    "name": "OSWFM - Code Types CRUD",
    "description": "CRUD operations for Code Types API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:1110",
      "type": "string"
    },
