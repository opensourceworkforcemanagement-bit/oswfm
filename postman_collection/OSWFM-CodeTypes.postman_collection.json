      "key": "codeTypeId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Create Code Type - Work Code",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"codeTypeName\": \"WORK_CODE\",\n  \"description\": \"Work codes for timesheet entries\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/code-types/create",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "code-types", "create"]
        },
        "description": "Create a new code type for work codes"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Response has codeTypeId\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.codeTypeId).to.exist;",
              "    pm.collectionVariables.set(\"codeTypeId\", jsonData.codeTypeId);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
