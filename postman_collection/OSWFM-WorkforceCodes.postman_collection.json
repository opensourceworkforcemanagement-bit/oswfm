{
  "info": {
    "_postman_id": "workforce-codes-collection",
    "name": "OSWFM - Workforce Codes CRUD",
    "description": "CRUD operations for Workforce Codes API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:1110",
      "type": "string"
    },
    {
      "key": "workforceCodeId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Create Workforce Code",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"codeType\": \"WORK\",\n  \"codeId\": 100,\n  \"shortCodeValue\": \"REG\",\n  \"longCodeValue\": \"Regular Hours\",\n  \"description\": \"Standard regular working hours\",\n  \"status\": 1,\n  \"effectiveDate\": \"2026-01-01\",\n  \"expirationDate\": null\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/workforce-codes/create",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "workforce-codes", "create"]
        },
        "description": "Create a new workforce code"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Response has workforceCodesId\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.workforceCodesId).to.exist;",
              "    pm.collectionVariables.set(\"workforceCodeId\", jsonData.workforceCodesId);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Create Workforce Code - Overtime",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"codeType\": \"WORK\",\n  \"codeId\": 101,\n  \"shortCodeValue\": \"OT\",\n  \"longCodeValue\": \"Overtime Hours\",\n  \"description\": \"Overtime working hours at 1.5x rate\",\n  \"status\": 1,\n  \"effectiveDate\": \"2026-01-01\",\n  \"expirationDate\": null\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/workforce-codes/create",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "workforce-codes", "create"]
        },
        "description": "Create an overtime workforce code"
      },
      "response": []
    },
