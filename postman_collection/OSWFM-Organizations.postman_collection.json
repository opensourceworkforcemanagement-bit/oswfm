{
  "info": {
    "_postman_id": "organizations-collection",
    "name": "OSWFM - Organizations CRUD",
    "description": "CRUD operations for Organizations API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:9090",
      "type": "string"
    },
    {
      "key": "organizationId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Create Organization",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"organizationName\": \"ACME Corporation\",\n  \"organizationCode\": \"ACME\",\n  \"description\": \"Main corporate entity\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/organization",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "organization"]
        },
        "description": "Create a new organization"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Response has id\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.id).to.exist;",
              "    pm.collectionVariables.set(\"organizationId\", jsonData.id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Get All Organizations",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/organization",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "organization"]
        },
        "description": "Get all organizations"
      },
      "response": []
    },
    {
      "name": "Get Organization by ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/organization/{{organizationId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "organization", "{{organizationId}}"]
        },
        "description": "Get a specific organization by ID"
      },
      "response": []
    },
    {
      "name": "Update Organization",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"organizationName\": \"ACME Corporation - Updated\",\n  \"organizationCode\": \"ACME\",\n  \"description\": \"Main corporate entity - Updated\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/organization/{{organizationId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "organization", "{{organizationId}}"]
        },
        "description": "Update an existing organization"
      },
      "response": []
    },
    {
      "name": "Get Organizations Count",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/organization/count",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "organization", "count"]
        },
        "description": "Get total count of organizations"
      },
      "response": []
    },
    {
      "name": "Check Organization Exists",
      "request": {
        "method": "HEAD",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/organization/{{organizationId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "organization", "{{organizationId}}"]
        },
        "description": "Check if an organization exists by ID"
      },
      "response": []
    },
    {
      "name": "Delete Organization",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/organization/{{organizationId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "organization", "{{organizationId}}"]
        },
        "description": "Delete an organization by ID"
      },
      "response": []
    }
  ]
}
