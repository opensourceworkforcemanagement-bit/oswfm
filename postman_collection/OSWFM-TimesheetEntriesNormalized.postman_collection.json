{
  "info": {
    "_postman_id": "timesheet-entries-normalized-collection",
    "name": "OSWFM - Timesheet Entries Normalized CRUD",
    "description": "CRUD operations for Timesheet Entries Normalized API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:1110",
      "type": "string"
    },
    {
      "key": "timesheetEntriesId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "timesheetNormalizedId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "workforceCodeId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Create Timesheet Entry Normalized",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"timesheetNormalizedId\": 1,\n  \"workforceCodeIds\": [1, 2]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/timesheet-entries-normalized/create",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "timesheet-entries-normalized", "create"]
        },
        "description": "Create a new normalized timesheet entry with associated workforce codes"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Response has timesheetEntriesId\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.timesheetEntriesId).to.exist;",
              "    pm.collectionVariables.set(\"timesheetEntriesId\", jsonData.timesheetEntriesId);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Create Timesheet Entry - No Codes",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"timesheetNormalizedId\": 1\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/timesheet-entries-normalized/create",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "timesheet-entries-normalized", "create"]
        },
        "description": "Create a normalized timesheet entry without workforce codes"
      },
      "response": []
    },
