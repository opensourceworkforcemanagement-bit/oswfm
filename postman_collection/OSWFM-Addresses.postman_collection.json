{
  "info": {
    "_postman_id": "addresses-collection",
    "name": "OSWFM - Addresses CRUD",
    "description": "CRUD operations for Addresses API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:9090",
      "type": "string"
    },
    {
      "key": "addressId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Create Address",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"streetAddress1\": \"123 Main Street\",\n  \"streetAddress2\": \"Apt 4B\",\n  \"city\": \"Springfield\",\n  \"state\": \"IL\",\n  \"zipCode\": \"62701\",\n  \"country\": \"USA\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/addresses",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "addresses"]
        },
        "description": "Create a new address"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Response has id\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.id).to.exist;",
              "    pm.collectionVariables.set(\"addressId\", jsonData.id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Get All Addresses",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/addresses",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "addresses"]
        },
        "description": "Get all addresses"
      },
      "response": []
    },
    {
      "name": "Get Address by ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/addresses/{{addressId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "addresses", "{{addressId}}"]
        },
        "description": "Get a specific address by ID"
      },
      "response": []
    },
    {
      "name": "Update Address",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"streetAddress1\": \"456 Oak Avenue\",\n  \"streetAddress2\": \"Suite 100\",\n  \"city\": \"Springfield\",\n  \"state\": \"IL\",\n  \"zipCode\": \"62702\",\n  \"country\": \"USA\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/addresses/{{addressId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "addresses", "{{addressId}}"]
        },
        "description": "Update an existing address"
      },
      "response": []
    },
    {
      "name": "Get Addresses Count",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/addresses/count",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "addresses", "count"]
        },
        "description": "Get total count of addresses"
      },
      "response": []
    },
    {
      "name": "Check Address Exists",
      "request": {
        "method": "HEAD",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/addresses/{{addressId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "addresses", "{{addressId}}"]
        },
        "description": "Check if an address exists by ID"
      },
      "response": []
    },
    {
      "name": "Delete Address",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/addresses/{{addressId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "addresses", "{{addressId}}"]
        },
        "description": "Delete an address by ID"
      },
      "response": []
    }
  ]
}
