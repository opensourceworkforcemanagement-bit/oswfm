{
  "info": {
    "_postman_id": "pay-periods-collection",
    "name": "OSWFM - Pay Periods CRUD",
    "description": "CRUD operations for Pay Periods API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:1110",
      "type": "string"
    },
    {
      "key": "payPeriodId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Create Pay Period",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"payPeriodTypeId\": 1,\n  \"startDate\": \"2026-01-01\",\n  \"endDate\": \"2026-01-15\",\n  \"year\": 2026,\n  \"periodNumber\": 1\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/pay-periods",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "pay-periods"]
        },
        "description": "Create a new pay period"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Response has payPeriodId\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.payPeriodId).to.exist;",
              "    pm.collectionVariables.set(\"payPeriodId\", jsonData.payPeriodId);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Get All Pay Periods",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/pay-periods",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "pay-periods"]
        },
        "description": "Get all pay periods"
      },
      "response": []
    },
    {
      "name": "Get Pay Period by ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/pay-periods/{{payPeriodId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "pay-periods", "{{payPeriodId}}"]
        },
        "description": "Get a specific pay period by ID"
      },
      "response": []
    },
    {
      "name": "Update Pay Period",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"payPeriodTypeId\": 1,\n  \"startDate\": \"2026-01-01\",\n  \"endDate\": \"2026-01-31\",\n  \"year\": 2026,\n  \"periodNumber\": 1\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/pay-periods/{{payPeriodId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "pay-periods", "{{payPeriodId}}"]
        },
        "description": "Update an existing pay period"
      },
      "response": []
    },
    {
      "name": "Get Pay Periods Count",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/pay-periods/count",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "pay-periods", "count"]
        },
        "description": "Get total count of pay periods"
      },
      "response": []
    },
    {
      "name": "Delete Pay Period",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/pay-periods/{{payPeriodId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "pay-periods", "{{payPeriodId}}"]
        },
        "description": "Delete a pay period by ID"
      },
      "response": []
    }
  ]
}
