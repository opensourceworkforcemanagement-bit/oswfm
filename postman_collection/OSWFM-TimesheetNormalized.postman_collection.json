  "item": [
    {
      "name": "Create Timesheet Normalized",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"employeeId\": 1,\n  \"payPeriodId\": 1,\n  \"timesheetTypeId\": 1,\n  \"status\": 0\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/timesheets-normalized/create",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "timesheets-normalized", "create"]
        },
        "description": "Create a new normalized timesheet"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Response has timesheetNormalizedId\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.timesheetNormalizedId).to.exist;",
              "    pm.collectionVariables.set(\"timesheetNormalizedId\", jsonData.timesheetNormalizedId);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
