{
  "info": {
    "_postman_id": "timesheet-entry-minutes-collection",
    "name": "OSWFM - Timesheet Entry Minutes CRUD",
    "description": "CRUD operations for Timesheet Entry Minutes API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:1110",
      "type": "string"
    },
    {
      "key": "entryMinutesId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "timesheetEntriesId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Create Entry Minutes - Monday",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"timesheetEntriesId\": 1,\n  \"minutes\": 480.00,\n  \"dayOfWeek\": \"1\",\n  \"date\": \"2026-01-27\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/timesheet-entry-minutes/create",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "timesheet-entry-minutes", "create"]
        },
        "description": "Create entry minutes for Monday (480 min = 8 hours)"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Response has id\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.id).to.exist;",
              "    pm.collectionVariables.set(\"entryMinutesId\", jsonData.id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
